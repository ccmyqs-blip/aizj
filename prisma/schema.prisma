generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id              String              @id @default(cuid())
  title           String
  code            String
  category        String
  source          String?
  version         String              @default("v1")
  publishDate     DateTime?
  status          String              @default("ACTIVE")
  ingestError     String?
  ingestStage     String              @default("COMPLETED")
  textCoverage    Float               @default(0)
  pageCount       Int                 @default(0)
  parsedPageCount Int                 @default(0)
  ocrUsed         Boolean             @default(false)
  lastIngestAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  chunks          DocumentChunk[]
  ingestJobs      DocumentIngestJob[]

  @@unique([code, version])
  @@index([title])
  @@index([category])
  @@index([status])
  @@index([publishDate])
  @@index([ingestStage, status])
  @@index([lastIngestAt])
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  chapterTitle String?
  sectionTitle String?
  chunkText    String
  pageNumber   Int?
  keywords     String?
  sortOrder    Int
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings   DocumentChunkEmbedding[]

  @@index([documentId, sortOrder])
  @@index([chapterTitle])
  @@index([sectionTitle])
  @@index([pageNumber])
}

model DocumentChunkEmbedding {
  id         String        @id @default(cuid())
  chunkId    String
  model      String
  vector     String
  dimensions Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  chunk      DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, model])
  @@index([model])
  @@index([chunkId])
}

model QARecord {
  id                  String          @id @default(cuid())
  userId              String?
  conversationId      String?
  turnIndex           Int?
  question            String
  answer              String
  sourceChunkIds      String?
  modelName           String?
  retrievalQuery      String?
  retrievedChunkCount Int             @default(0)
  topChunkIds         String?
  topChunkScores      String?
  createdAt           DateTime        @default(now())
  ip                  String?
  userAgent           String?
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation        QAConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([modelName])
  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model DocumentIngestJob {
  id         String   @id @default(cuid())
  documentId String
  status     String   @default("PENDING")
  attempt    Int      @default(0)
  filePath   String
  fileName   String
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([documentId, createdAt])
}

model QAConversation {
  id        String     @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  records   QARecord[]

  @@index([userId, updatedAt])
}

model Lead {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  phone       String
  wechat      String?
  email       String?
  demand      String?
  sourcePage  String?
  createdAt   DateTime @default(now())
  status      String   @default("NEW")
  note        String?

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([companyName])
}

model AdminConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue String
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id           String   @id @default(cuid())
  feedbackType String   @default("GENERAL")
  sourcePage   String?
  content      String
  contact      String?
  rating       Int?
  status       String   @default("NEW")
  note         String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([sourcePage])
  @@index([feedbackType])
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
  qaRecords    QARecord[]
  qaConversations QAConversation[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
