          "chapterTitle": "第一部分 费用构成",
          "sectionTitle": "一、直接费",
          "chunkText": "直接费包括人工费、材料费、施工机具使用费等，是形成工程实体和完成施工所发生的直接支出。",
          "pageNumber": 6,
          "keywords": ["费用项目组成", "直接费", "人工费"],
          "sortOrder": 1
        },
        {
          "chapterTitle": "第一部分 费用构成",
          "sectionTitle": "二、企业管理费",
          "chunkText": "企业管理费应根据企业组织施工生产和经营管理活动所需费用综合测定，通常以规定基数乘费率计取。",
          "pageNumber": 9,
          "keywords": ["企业管理费", "费率", "计取"],
          "sortOrder": 2
        },
        {
          "chapterTitle": "第二部分 规费与税金",
          "sectionTitle": "三、税金",
          "chunkText": "税金应按照国家现行税收政策和计税规则计算，计价文件中应明确税率及计税基数口径。",
          "pageNumber": 14,
          "keywords": ["规费", "税金", "计税基数"],
          "sortOrder": 3
        }
      ]
