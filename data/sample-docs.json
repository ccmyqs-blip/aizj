      "code": "GB 50500-2013",
      "category": "国家标准",
      "source": "住房和城乡建设部",
      "version": "2013",
      "publishDate": "2013-12-25",
      "status": "ACTIVE",
      "chunks": [
        {
          "chapterTitle": "第3章 工程量清单编制",
          "sectionTitle": "3.1 一般规定",
          "chunkText": "工程量清单应依据统一工程量计算规则编制，项目特征描述应完整、准确，并应满足计价和合同管理需要。",
          "pageNumber": 18,
          "keywords": ["工程量清单", "项目特征", "计价"],
          "sortOrder": 1
        },
        {
          "chapterTitle": "第5章 招标控制价",
          "sectionTitle": "5.2 编制依据",
          "chunkText": "招标控制价应结合工程量清单、计价定额、市场价格信息及有关费用标准进行编制，并保持依据可追溯。",
          "pageNumber": 42,
          "keywords": ["招标控制价", "计价定额", "市场价格"],
          "sortOrder": 2
        },
        {
          "chapterTitle": "第9章 合同价款调整",
          "sectionTitle": "9.3 工程变更",
          "chunkText": "因工程变更引起工程量增减的，应按合同约定的计价原则调整合同价款；合同未约定的，可参照类似项目综合单价确定。",
          "pageNumber": 74,
          "keywords": ["工程变更", "合同价款调整", "综合单价"],
          "sortOrder": 3
        },
        {
          "chapterTitle": "第10章 工程结算",
          "sectionTitle": "10.1 一般规定",
          "chunkText": "工程结算应以合同约定、经确认的工程量及相关签证资料为依据，确保结算资料完整和逻辑一致。",
          "pageNumber": 82,
          "keywords": ["工程结算", "签证资料", "合同约定"],
          "sortOrder": 4
        }
      ]
    },
    {
      "title": "房屋建筑与装饰工程工程量计算规范",
