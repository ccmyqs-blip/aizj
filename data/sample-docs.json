      "publishDate": "2017-10-01",
      "status": "ACTIVE",
      "chunks": [
        {
          "chapterTitle": "通用合同条款",
          "sectionTitle": "14.1 合同价格形式",
          "chunkText": "合同价款可采用总价合同、单价合同或成本加酬金合同；具体价格调整机制应以专用合同条款约定为准。",
          "pageNumber": 52,
          "keywords": ["合同价款", "单价合同", "总价合同"],
          "sortOrder": 1
        },
        {
          "chapterTitle": "通用合同条款",
          "sectionTitle": "14.2 预付款与进度款",
          "chunkText": "发包人应按合同约定支付预付款和进度款，承包人应按已完工程量和约定计价方法报送支付申请。",
          "pageNumber": 54,
          "keywords": ["进度款", "已完工程量", "支付申请"],
          "sortOrder": 2
        },
        {
          "chapterTitle": "通用合同条款",
          "sectionTitle": "15.3 变更估价",
          "chunkText": "工程变更的估价应优先适用合同中已有综合单价；无适用单价时可按合理成本加约定利润确定，并履行确认程序。",
          "pageNumber": 61,
          "keywords": ["变更估价", "综合单价", "签证"],
          "sortOrder": 3
        },
        {
          "chapterTitle": "通用合同条款",
          "sectionTitle": "17.1 竣工结算",
          "chunkText": "竣工结算应基于合同约定、设计变更、现场签证及已完工程量资料进行审核，争议部分可按约定程序处理。",
          "pageNumber": 72,
          "keywords": ["竣工结算", "现场签证", "结算审核"],
          "sortOrder": 4
        }
      ]
    }
