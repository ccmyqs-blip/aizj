# ---- Core ----
# Local dev suggestion:
# DATABASE_URL="file:./dev.db"
# Docker production can override to: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Public site url for SEO/OG links
NEXT_PUBLIC_SITE_URL="http://localhost"
# Cookie secure policy:
# - true: always set Secure
# - false: never set Secure
# - unset: auto by NEXT_PUBLIC_SITE_URL (https => true, http => false)
COOKIE_SECURE="false"

# ---- Admin ----
# Required: admin password is loaded from env only
ADMIN_PASSWORD="ChangeThisToStrongPassword"
# Admin session max age in seconds (default 12h)
ADMIN_SESSION_MAX_AGE_SECONDS="43200"
# Brute-force guard: block after failures > this value
ADMIN_LOGIN_MAX_FAILURES="5"
# Brute-force guard block time in minutes
ADMIN_LOGIN_BLOCK_MINUTES="15"

# ---- LLM (Aliyun DashScope/Bailian) ----
# Optional for mock-only demo; required for real QA generation
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL="qwen-plus"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_TIMEOUT_MS="12000"

# ---- Embedding ----
DASHSCOPE_TEXT_EMBEDDING_MODEL="text-embedding-v4"
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL="qwen3-vl-embedding"
DASHSCOPE_NATIVE_BASE_URL="https://dashscope.aliyuncs.com"
DASHSCOPE_EMBEDDING_TIMEOUT_MS="15000"
EMBEDDING_MAX_CHUNKS_PER_DOC="60"
EMBEDDING_CONCURRENCY="2"
# Background ingest worker concurrency for document upload (single-machine recommendation: 1)
UPLOAD_WORKER_CONCURRENCY="1"
INGEST_JOB_MAX_ATTEMPTS="2"
INGEST_TEXT_COVERAGE_THRESHOLD="0.20"
INGEST_CHUNK_MIN_LENGTH="300"
INGEST_CHUNK_MAX_LENGTH="600"
INGEST_CHUNK_OVERLAP="50"
INGEST_MAX_CHUNK_COUNT="500"
INGEST_MIN_MEANINGFUL_PAGE_TEXT="20"
RETRIEVER_MAX_EMBEDDING_ROWS="3000"
RETRIEVER_MAX_TOP_EMBEDDING_MATCHES="80"
RETRIEVER_MIN_TEXT_COVERAGE="0.20"

# ---- Cloud OCR (optional async fallback for scanned PDF) ----
CLOUD_OCR_ENABLED="false"
CLOUD_OCR_SUBMIT_URL=""
CLOUD_OCR_RESULT_URL_TEMPLATE=""
CLOUD_OCR_API_KEY=""
CLOUD_OCR_TIMEOUT_MS="180000"
CLOUD_OCR_POLL_INTERVAL_MS="3000"
INGEST_REBUILD_WAIT_TIMEOUT_MS="1800000"
INGEST_REBUILD_WAIT_INTERVAL_MS="3000"

# ---- Captcha (MVP mock switch) ----
# Backend switch
CAPTCHA_ENABLED="false"
# Frontend UI switch for /trial page
NEXT_PUBLIC_CAPTCHA_ENABLED="false"
# Mock pass token when CAPTCHA_ENABLED=true
CAPTCHA_MOCK_PASS_TOKEN="mock-pass"

# ---- App-level rate limit ----
# Global switch: set true to disable rate limit
RATE_LIMIT_DISABLED="false"
# Dev-only bypass for local debugging
DISABLE_RATE_LIMIT_IN_DEV="false"
# Admin upload route (/api/admin/documents/upload) per-IP limit per minute
ADMIN_UPLOAD_RATE_LIMIT_PER_MINUTE="20"
# Admin document delete route (/api/admin/documents/:id) per-IP limit per minute
ADMIN_DOCUMENT_DELETE_RATE_LIMIT_PER_MINUTE="20"
