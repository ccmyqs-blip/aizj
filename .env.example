# ---- Core ----
# Local dev suggestion:
# DATABASE_URL="file:./dev.db"
# Docker production can override to: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Public site url for SEO/OG links
NEXT_PUBLIC_SITE_URL="http://localhost"

# ---- Admin ----
# Required: admin password is loaded from env only
ADMIN_PASSWORD="ChangeThisToStrongPassword"
# Admin session max age in seconds (default 12h)
ADMIN_SESSION_MAX_AGE_SECONDS="43200"
# Brute-force guard: block after failures > this value
ADMIN_LOGIN_MAX_FAILURES="5"
# Brute-force guard block time in minutes
ADMIN_LOGIN_BLOCK_MINUTES="15"

# ---- LLM (Aliyun DashScope/Bailian) ----
# Optional for mock-only demo; required for real QA generation
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL="qwen-plus"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_TIMEOUT_MS="12000"

# ---- Embedding ----
DASHSCOPE_TEXT_EMBEDDING_MODEL="text-embedding-v4"
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL="qwen3-vl-embedding"
DASHSCOPE_NATIVE_BASE_URL="https://dashscope.aliyuncs.com"
DASHSCOPE_EMBEDDING_TIMEOUT_MS="15000"
EMBEDDING_MAX_CHUNKS_PER_DOC="60"
EMBEDDING_CONCURRENCY="2"
RETRIEVER_MAX_EMBEDDING_ROWS="3000"
RETRIEVER_MAX_TOP_EMBEDDING_MATCHES="80"

# ---- Captcha (MVP mock switch) ----
# Backend switch
CAPTCHA_ENABLED="false"
# Frontend UI switch for /trial page
NEXT_PUBLIC_CAPTCHA_ENABLED="false"
# Mock pass token when CAPTCHA_ENABLED=true
CAPTCHA_MOCK_PASS_TOKEN="mock-pass"

# ---- App-level rate limit ----
# Global switch: set true to disable rate limit
RATE_LIMIT_DISABLED="false"
# Dev-only bypass for local debugging
DISABLE_RATE_LIMIT_IN_DEV="false"
