# ---- Core ----
# Local dev suggestion:
# DATABASE_URL="file:./dev.db"
# Docker production is overridden by docker-compose to: file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Public site url for SEO/OG links
NEXT_PUBLIC_SITE_URL="http://localhost"

# Required in production (admin backend password)
ADMIN_PASSWORD="ChangeThisToStrongPassword"

# ---- LLM (Aliyun DashScope/Bailian) ----
# Optional for initial mock-only demo; required for real QA generation
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL="qwen-plus"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
